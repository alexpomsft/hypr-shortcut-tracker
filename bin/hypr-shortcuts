#!/usr/bin/env python3

import argparse
import csv
import datetime as dt
import json
import os
import sqlite3
import sys
import time
from contextlib import closing
from pathlib import Path


APP_NAME = "hypr-shortcut-tracker"
VERSION = "0.2.0"
STATE_DIR = Path(
    os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local" / "state"))
) / APP_NAME
DB_PATH = STATE_DIR / "usage.sqlite3"
CATALOG_PATH = STATE_DIR / "bindings.tsv"

FAMILIES = {
    "workspace-switch": "Switch to workspace",
    "workspace-move-window": "Move window to workspace",
    "workspace-move-window-silent": "Move window silently to workspace",
    "group-window-select": "Select window within a group",
    "bar-panel-open": "Open bar panel",
    "window-focus-direction": "Focus adjacent window",
    "window-swap-direction": "Swap window",
    "workspace-move-monitor": "Move workspace to another monitor",
    "window-move-group": "Move window into adjacent group",
    "window-resize-keyboard": "Resize window using keyboard",
}
FLAT_FIELDS = [
    "shortcut", "description", "count", "share_percent", "first_used",
    "last_used", "last_used_relative", "review",
]
GROUPED_FIELDS = FLAT_FIELDS + ["family_id", "used_bindings", "binding_count"]


def normalize_shortcut(shortcut: str) -> str:
    parts = [part.strip() for part in shortcut.split("+")]
    return " + ".join([*sorted(part.upper() for part in parts[:-1]), parts[-1]])


def build_family_bindings() -> dict[tuple[str, str], str]:
    bindings = {}

    def add(family: str, shortcut: str, description: str) -> None:
        bindings[(normalize_shortcut(shortcut), description)] = family

    for workspace in range(1, 11):
        for family, modifiers in (
            ("workspace-switch", "SUPER"),
            ("workspace-move-window", "SUPER + SHIFT"),
            ("workspace-move-window-silent", "SUPER + SHIFT + ALT"),
        ):
            add(
                family,
                f"{modifiers} + code:{workspace + 9}",
                f"{FAMILIES[family]} {workspace}",
            )
    for index in range(1, 6):
        add("group-window-select", f"SUPER + ALT + code:{index + 9}", f"Switch to group window {index}")
    for index in range(1, 10):
        add("bar-panel-open", f"SUPER + CTRL + code:{index + 9}", f"Bar panel {index}")

    for key, direction, focus_direction, group_direction in (
        ("LEFT", "left", "left", "left"),
        ("RIGHT", "right", "right", "right"),
        ("UP", "up", "above", "top"),
        ("DOWN", "down", "below", "bottom"),
    ):
        add("window-focus-direction", f"SUPER + {key}", f"Focus on {focus_direction} window")
        swap_direction = f"to the {direction}" if key in {"LEFT", "RIGHT"} else direction
        add("window-swap-direction", f"SUPER + SHIFT + {key}", f"Swap window {swap_direction}")
        add("workspace-move-monitor", f"SUPER + SHIFT + ALT + {key}", f"Move workspace to {direction} monitor")
        add("window-move-group", f"SUPER + ALT + {key}", f"Move window to group on {group_direction}")

    for modifiers, suffix in (
        ("SUPER", ""),
        ("SUPER + ALT", " a little"),
        ("SUPER + CTRL", " a lot"),
    ):
        for extra, code, description in (
            ("", 20, "Expand window left"),
            ("", 21, "Shrink window left"),
            (" + SHIFT", 20, "Shrink window up"),
            (" + SHIFT", 21, "Expand window down"),
        ):
            add("window-resize-keyboard", f"{modifiers}{extra} + code:{code}", description + suffix)
    return bindings


FAMILY_BINDINGS = build_family_bindings()


def family_for(shortcut: str, description: str) -> str | None:
    return FAMILY_BINDINGS.get((normalize_shortcut(shortcut), description))


def connect() -> sqlite3.Connection:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    connection = sqlite3.connect(DB_PATH, timeout=5)
    try:
        connection.execute("PRAGMA journal_mode=WAL")
        connection.execute(
            """
            CREATE TABLE IF NOT EXISTS usage (
                shortcut TEXT PRIMARY KEY,
                invocation_count INTEGER NOT NULL,
                first_used_at INTEGER NOT NULL,
                last_used_at INTEGER NOT NULL
            )
            """
        )
    except sqlite3.Error:
        connection.close()
        raise
    return connection


def record(shortcut: str) -> int:
    now = int(time.time())
    with closing(connect()) as connection, connection:
        connection.execute(
            """
            INSERT INTO usage (
                shortcut, invocation_count, first_used_at, last_used_at
            ) VALUES (?, 1, ?, ?)
            ON CONFLICT(shortcut) DO UPDATE SET
                invocation_count = invocation_count + 1,
                first_used_at = MIN(first_used_at, excluded.first_used_at),
                last_used_at = MAX(last_used_at, excluded.last_used_at)
            """,
            (shortcut, now, now),
        )
    return 0


def load_catalog() -> dict[str, str]:
    bindings: dict[str, list[str]] = {}
    try:
        with CATALOG_PATH.open(encoding="utf-8") as catalog:
            for line_number, line in enumerate(catalog, 1):
                shortcut, separator, description = line.rstrip("\n").partition("\t")
                if not shortcut or not separator or "\t" in description:
                    raise ValueError(f"Malformed catalog entry: {CATALOG_PATH}:{line_number}")
                descriptions = bindings.setdefault(shortcut, [])
                if description and description not in descriptions:
                    descriptions.append(description)
    except FileNotFoundError:
        print(
            f"Binding catalog missing: {CATALOG_PATH}. Install the tracker and reload Hyprland.",
            file=sys.stderr,
        )
    return {shortcut: " / ".join(descriptions) for shortcut, descriptions in bindings.items()}


def load_usage() -> dict[str, tuple[int, int, int]]:
    if not DB_PATH.exists():
        return {}
    with closing(connect()) as connection:
        return {
            shortcut: (count, first_used, last_used)
            for shortcut, count, first_used, last_used in connection.execute(
                """
                SELECT shortcut, invocation_count, first_used_at, last_used_at
                FROM usage
                """
            )
        }


def relative_time(timestamp: int | None, now: int) -> str:
    if timestamp is None:
        return "NEVER"
    seconds = max(0, now - timestamp)
    units = (
        (31_536_000, "y"),
        (2_592_000, "mo"),
        (604_800, "w"),
        (86_400, "d"),
        (3_600, "h"),
        (60, "m"),
    )
    for size, suffix in units:
        if seconds >= size:
            return f"{seconds // size}{suffix} ago"
    return "just now"


def iso_time(timestamp: int | None) -> str:
    if timestamp is None:
        return ""
    return dt.datetime.fromtimestamp(timestamp).astimezone().isoformat(
        timespec="seconds"
    )


def review_hint(count: int, last_used: int | None, now: int, stale_days: int) -> str:
    if count == 0:
        return "LEARN / REMOVE"
    if last_used is not None and now - last_used >= stale_days * 86_400:
        return "REVIEW"
    return ""


def report_rows(stale_days: int) -> list[dict[str, object]]:
    catalog = load_catalog()
    usage = load_usage()
    shortcuts = set(catalog) | set(usage)
    now = int(time.time())
    total = sum(values[0] for values in usage.values())
    rows = []
    for shortcut in shortcuts:
        count, first_used, last_used = usage.get(shortcut, (0, None, None))
        rows.append(
            {
                "shortcut": shortcut,
                "description": catalog.get(shortcut, "(no longer configured)"),
                "count": count,
                "share_percent": round(count * 100 / total, 1) if total else 0.0,
                "first_used": iso_time(first_used),
                "last_used": iso_time(last_used),
                "last_used_relative": relative_time(last_used, now),
                "review": review_hint(count, last_used, now, stale_days),
                "_first_used_epoch": first_used or 0,
                "_last_used_epoch": last_used or 0,
                "_configured": shortcut in catalog,
                "_family_id": family_for(shortcut, catalog[shortcut]) if shortcut in catalog else None,
            }
        )
    return rows


def group_rows(
    rows: list[dict[str, object]], stale_days: int, total: int | None = None
) -> list[dict[str, object]]:
    if total is None:
        total = sum(int(row["count"]) for row in rows)
    members: dict[str, list[dict[str, object]]] = {}
    grouped = []
    for row in rows:
        family = row["_family_id"]
        if family is None:
            grouped.append({
                **row,
                "family_id": "",
                "used_bindings": int(int(row["count"]) > 0),
                "binding_count": 1,
            })
        else:
            members.setdefault(str(family), []).append(row)

    now = int(time.time())
    for family, bindings in members.items():
        used = [row for row in bindings if int(row["count"]) > 0]
        count = sum(int(row["count"]) for row in bindings)
        first_used = min((int(row["_first_used_epoch"]) for row in used), default=None)
        last_used = max((int(row["_last_used_epoch"]) for row in used), default=None)
        grouped.append({
            "shortcut": "",
            "description": FAMILIES[family],
            "count": count,
            "share_percent": round(count * 100 / total, 1) if total else 0.0,
            "first_used": iso_time(first_used),
            "last_used": iso_time(last_used),
            "last_used_relative": relative_time(last_used, now),
            "review": review_hint(count, last_used, now, stale_days),
            "family_id": family,
            "used_bindings": len(used),
            "binding_count": len(bindings),
            "_last_used_epoch": last_used or 0,
        })
    return grouped


def sort_rows(rows: list[dict[str, object]], order: str) -> None:
    def identity(row: dict[str, object]) -> str:
        return str(row.get("family_id") or row["shortcut"])

    if order == "recent":
        rows.sort(
            key=lambda row: (
                -int(row["_last_used_epoch"]),
                -int(row["count"]),
                identity(row),
            )
        )
    elif order == "review":
        priority = {"LEARN / REMOVE": 0, "REVIEW": 1, "": 2}
        rows.sort(
            key=lambda row: (
                priority[str(row["review"])],
                int(row["count"]),
                int(row["_last_used_epoch"]),
                identity(row),
            )
        )
    else:
        rows.sort(
            key=lambda row: (
                -int(row["count"]),
                -int(row["_last_used_epoch"]),
                identity(row),
            )
        )


def print_table(rows: list[dict[str, object]], grouped: bool = False) -> None:
    if not rows:
        print("No shortcuts found. Reload Hyprland to generate the binding catalog.")
        return
    headers = ("COUNT", "SHARE", "LAST USED", "REVIEW", "SHORTCUT", "ACTION")
    if grouped:
        headers = ("COUNT", "SHARE", "LAST USED", "COVERAGE", "REVIEW", "SHORTCUT / FAMILY", "ACTION")
    rendered = [
        (
            str(row["count"]),
            f'{row["share_percent"]:.1f}%',
            str(row["last_used_relative"]),
            str(row["review"]),
            str(row.get("family_id") or row["shortcut"]),
            str(row["description"]),
        )
        for row in rows
    ]
    if grouped:
        rendered = [
            (
                *values[:3],
                f'{row["used_bindings"]}/{row["binding_count"]} used',
                *values[3:],
            )
            for row, values in zip(rows, rendered)
        ]
    widths = [
        max(len(headers[index]), *(len(row[index]) for row in rendered))
        for index in range(len(headers))
    ]
    review_index, shortcut_index = (4, 5) if grouped else (3, 4)
    for index in (review_index, shortcut_index):
        widths[index] = min(widths[index], 28 if index == shortcut_index else 14)
    print(
        "  ".join(
            header.ljust(widths[index]) for index, header in enumerate(headers)
        )
    )
    print("  ".join("-" * width for width in widths))
    for row in rendered:
        print(
            "  ".join(
                value.ljust(widths[index]) if index else value.rjust(widths[index])
                for index, value in enumerate(row)
            )
        )


def print_structured(
    rows: list[dict[str, object]], output_format: str, grouped: bool = False
) -> None:
    public_rows = [
        {key: value for key, value in row.items() if not key.startswith("_")}
        for row in rows
    ]
    if output_format == "json":
        json.dump(public_rows, sys.stdout, indent=2)
        print()
        return
    writer = csv.DictWriter(
        sys.stdout,
        fieldnames=GROUPED_FIELDS if grouped else FLAT_FIELDS,
    )
    writer.writeheader()
    writer.writerows(public_rows)


def report(args: argparse.Namespace) -> int:
    rows = report_rows(args.stale_days)
    total = sum(int(row["count"]) for row in rows)
    if args.family:
        rows = [row for row in rows if row["_family_id"] == args.family]
    grouping = args.group_by or ("shortcut" if args.family else "family")
    grouped = grouping == "family"
    if grouped:
        rows = group_rows(rows, args.stale_days, total)
    sort_rows(rows, args.sort)
    if args.limit:
        rows = rows[: args.limit]
    if args.format == "table":
        if not rows and args.family:
            print(f"No configured bindings match family '{args.family}'.")
        else:
            print_table(rows, grouped)
    else:
        print_structured(rows, args.format, grouped)
    return 0


def status() -> int:
    catalog = load_catalog()
    usage = load_usage()
    print(f"Database: {DB_PATH}")
    print(f"Catalog:  {CATALOG_PATH}")
    print(f"Configured shortcuts: {len(catalog)}")
    print(f"Used shortcuts:       {len(usage)}")
    print(f"Total invocations:    {sum(value[0] for value in usage.values())}")
    return 0


def reset(confirmed: bool) -> int:
    if not confirmed:
        if not sys.stdin.isatty():
            print("Refusing to reset without --yes in a non-interactive shell.", file=sys.stderr)
            return 2
        answer = input("Delete all shortcut usage history? [y/N] ")
        if answer.lower() not in {"y", "yes"}:
            print("History kept.")
            return 0
    if DB_PATH.exists():
        with closing(connect()) as connection, connection:
            connection.execute("DELETE FROM usage")
    print("Shortcut usage history deleted.")
    return 0


def positive_int(value: str) -> int:
    number = int(value)
    if number <= 0:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return number


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Track and report Omarchy/Hyprland shortcut usage."
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    subparsers = parser.add_subparsers(dest="command", required=True)

    record_parser = subparsers.add_parser("record", help=argparse.SUPPRESS)
    record_parser.add_argument("--key", required=True)

    report_parser = subparsers.add_parser("report", help="Show shortcut analytics.")
    report_parser.add_argument(
        "--sort", choices=("frequency", "recent", "review"), default="frequency"
    )
    report_parser.add_argument(
        "--format", choices=("table", "json", "csv"), default="table"
    )
    report_parser.add_argument("--stale-days", type=positive_int, default=30)
    report_parser.add_argument("--limit", type=positive_int)
    report_parser.add_argument(
        "--group-by", choices=("family", "shortcut"),
        help="Group by action family (default) or show individual shortcuts.",
    )
    report_parser.add_argument(
        "--family", choices=tuple(FAMILIES),
        help="Show a family's individual bindings unless --group-by family is also specified.",
    )

    subparsers.add_parser("status", help="Show tracker paths and totals.")
    reset_parser = subparsers.add_parser("reset", help="Delete usage history.")
    reset_parser.add_argument("--yes", action="store_true")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if args.command == "record":
        return record(args.key)
    if args.command == "report":
        return report(args)
    if args.command == "status":
        return status()
    if args.command == "reset":
        return reset(args.yes)
    return 2


if __name__ == "__main__":
    try:
        exit_code = main()
    except (sqlite3.Error, OSError, ValueError) as error:
        print(f"hypr-shortcuts: {error}", file=sys.stderr)
        exit_code = 1
    raise SystemExit(exit_code)
